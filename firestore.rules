// Firestore security rules for the block_blast global leaderboard.
//
// These are NOT deployed automatically — this file was generated by the
// build agent, which has no access to the Firebase console/CLI credentials
// for this project. To apply them:
//   1. Firebase Console -> Firestore Database -> Rules -> paste this file's
//      contents -> Publish, OR
//   2. If you have the Firebase CLI set up locally, place this file at the
//      repo root (already done) and run:
//        firebase deploy --only firestore:rules
//
// Also make sure both Cloud Firestore and Anonymous Authentication are
// enabled for this project in the Firebase console — the app assumes they
// are, and degrades gracefully (silently) if they are not.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidEntry(request.resource.data)
        && request.resource.data.score > resource.data.score;

      allow delete: if false;

      function isValidEntry(data) {
        return data.score is number
          && data.nickname is string
          && data.nickname.size() <= 24;
      }
    }
  }
}
